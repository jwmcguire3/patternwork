    "no_replay_trees": true,
    "all_actualness_derived_from_canonical_response": true
  },
  "factual_guards": [
    "bothersome_comment",
    "need_became_known",
    "noticed_feeling_without_acting"
  ],
  "corrections": {
    "storage": "append_only_journal_with_supersession",
    "recompute": "bounded_full_replay_and_dependency_aware_invalidation",
    "dependency_aspects": [
      "content",
      "status_basis",
      "option:canonical_option_id",
      "context_fact"
    ],
    "post_finish": "new_revision_no_automatic_reopening_or_delivery",
    "interpretation_disagreement": "withdraw_relevant_derived_support_keep_literal_evidence"
  },
  "budgets": {
    "max_administrations": 56,
    "max_mapping_administrations": 32,
    "max_decisions": 72,
    "skip_counts_as_administration": true,
    "mixed_response_decisions": 3,
    "partial_order_decisions": "selected_count+1",
    "automatic_scope_texture_allowance": 3,
    "shorten": "suppress_tier_5_and_6_non_short_block_candidates"
  },
  "priority_clarifications": {
    "replay_requirement_gain": 2,
    "visible_need_discriminator_requirement_gain": 2,
    "meaning": "authored requirement counts, not statistical information gain"
  },
  "report": {
    "packet_format": "patternwork-router-evidence-v1",
    "schema": "schemas/router_packet.schema.json",
    "final_interpretation_authority": "writer_and_semantic_review",
    "requires_honoring_interpretation_disputes": true,
    "no_required_motive_selection_for_writer_inference": true
  },
  "trust": {
    "answers_allow": [
      "selected",
      "status",
      "mode",
      "basis"
    ],
    "prohibit_client_targets_and_evidence": true,
    "state_envelope": "HMAC-SHA256_signed_not_encrypted",
    "snapshot_source_binding": "canonical_question_target_gate_and_runtime_source_hash",
    "local_unsigned_snapshot": "explicit_local_test_only_never_production_load"
  },
  "coverage_extension": {
    "additional_templates": 36,
    "additional_descriptive_targets": 36,
    "existing_item_reachability_targets": 3,
    "automatic_theory_classification": false,
    "default_budgets_changed": false
