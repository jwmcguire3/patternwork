# Required for assessment persistence (PostgreSQL/Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Patternwork v3.1 assessment privacy and access keys.
# Generate independent 32-byte random values for each key.
APP_DATA_ENCRYPTION_KEY=""
APP_DATA_ENCRYPTION_KEY_VERSION="v1"
EMAIL_LOOKUP_HMAC_KEY=""
ASSESSMENT_COOKIE_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: enables assessment submission email delivery through Resend
RESEND_API_KEY=""
EMAIL_FROM=""
REPORT_BCC_EMAIL=""
RESEND_WEBHOOK_SECRET=""

# OpenRouter report generation remains disabled until these are configured.
OPENROUTER_API_KEY=""
OPENROUTER_MAX_COST_PER_ASSESSMENT_USD=""
OPENROUTER_APP_URL="http://localhost:3000"
OPENROUTER_APP_NAME="Patternwork"

# Optional: expose assessment developer tools in the browser
NEXT_PUBLIC_SHOW_ASSESSMENT_DEVTOOLS="false"
