{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "report_release": {
      "const": "PWRP-7.1.0-candidate.1"
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "evidence_sha256": {
      "type": "string",
      "minLength": 1
    },
    "report_type": {
      "enum": [
        "MAP",
        "IFS",
        "PV",
        "ATT",
        "SYNTHESIS"
      ]
    },
    "formulation_contract": {
      "const": "PWRP-FORMULATION-3"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "reported",
              "supported_interpretation",
              "open_question",
              "not_assessed"
            ]
          },
          "constructs": {
            "type": "array",
            "items": {
              "enum": [
                "manager",
                "firefighter",
                "protective_function",
                "exile",
                "vulnerable_part",
                "vulnerable_theme",
                "internal_exclusion",
                "organizing_belief",
                "burden",
                "self_led_capacity",
                "unblending",
                "polarization",
                "part_relationship",
                "handoff",
                "loop",
                "state_pattern",
                "state_transition",
                "state_dependent_cognition",
                "recovery",
                "co_regulation",
                "attachment_anxiety",
                "attachment_avoidance",
                "secure_functioning",
                "working_expectation",
                "relational_pace",
                "repair",
                "context_contrast",
                "recurrence",
                "capacity",
                "practical_explanation",
                "description",
                "scope_limit"
              ]
            },
            "uniqueItems": true,
            "description": "Use the active construct guide. In particular burden requires an evidenced current constraining extreme belief or feeling carried by a part, not an ordinary expectation or a cost; no acquisition history follows from the label."
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "level": {
                "enum": [
                  "occurrence",
                  "reported_tendency",
                  "recurring_within_context",
                  "across_sampled_contexts",
                  "not_assessed"
                ]
              },
              "occurrence_ids": {
                "description": "Occurrence IDs represented by this claim's evidence_ids and counterevidence_ids. Every cited observation must be included. Reported and supported_interpretation claims may not include unsupported extra occurrences.",
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "person_ids": {
                "description": "Person IDs represented by cited evidence and counterevidence observations when present. Every cited person must be included. Reported and supported_interpretation claims may not include unsupported extra people.",
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "level",
              "occurrence_ids",
              "person_ids",
              "description"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "counterevidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "sequence_edge_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "depends_on_claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "support_basis": {
            "type": "array",
            "items": {
              "enum": [
                "direct_report",
                "stated_aim",
                "remembered_expectation",
                "reported_effect",
                "inferred_function",
                "model_formulation",
                "actual_sequence",
                "context_comparison",
                "reported_typicality",
                "scope_limit"
              ]
            },
            "uniqueItems": true
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "remaining_uncertainty": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "text",
          "kind",
          "constructs",
          "scope",
          "evidence_ids",
          "counterevidence_ids",
          "sequence_edge_ids",
          "depends_on_claim_ids",
          "support_basis",
          "rationale",
          "remaining_uncertainty"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "reported",
                    "supported_interpretation"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "evidence_ids": {
                  "minItems": 1
                },
                "scope": {
                  "properties": {
                    "occurrence_ids": {
                      "minItems": 1
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "name_registry": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "entity_kind": {
            "enum": [
              "ifs_part",
              "state_pattern",
              "relational_pattern",
              "descriptive_pattern"
            ]
          },
          "role": {
            "description": "Use a specific theoretical role only when a listed supporting claim is a supported_interpretation with the same role in constructs; otherwise use an appropriate broader category.",
            "enum": [
              "manager",
              "firefighter",
              "exile",
              "protective_part",
              "context_dependent",
              "vulnerable_part",
              "descriptive_pattern"
            ]
          },
          "author_generated": {
            "type": "boolean"
          },
          "supporting_claim_ids": {
            "description": "Claims that support this entity. For manager, firefighter, exile, or vulnerable_part roles, at least one ID must refer to a supported_interpretation claim with the same role in constructs.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "name_id",
          "name",
          "entity_kind",
          "role",
          "author_generated",
          "supporting_claim_ids"
        ]
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from_name_id": {
            "type": "string",
            "minLength": 1
          },
          "to_name_id": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "enum": [
              "protects",
              "polarized_with",
              "reinforces",
              "takes_over_from",
              "shares_protective_target_with",
              "contrasts_with"
            ]
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "id",
          "from_name_id",
          "to_name_id",
          "relation",
          "claim_ids"
        ]
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "pattern",
              "mechanism",
              "need",
              "burden",
              "contrast",
              "context",
              "possibility"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "applicability": {
            "type": "string"
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "entity_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "importance": {
            "enum": [
              "core",
              "supporting"
            ]
          },
          "delivery": {
            "enum": [
              "develop",
              "embed",
              "guardrail"
            ],
            "description": "develop: an insight to explain; embed: consequential context woven into it; guardrail: a private-to-narrator limit, not a required topic or citable narrative unit."
          }
        },
        "required": [
          "id",
          "kind",
          "statement",
          "applicability",
          "claim_ids",
          "entity_ids",
          "importance",
          "delivery"
        ]
      }
    },
    "organizing_unit_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "development_order": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "unit_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "reframes_unit_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "purpose",
          "unit_ids",
          "reframes_unit_ids"
        ]
      }
    },
    "exile_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": [
              "earned_exile",
              "vulnerable_part",
              "theme",
              "omit"
            ]
          },
          "name_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "examined_claim_ids": {
            "type": "array",
            "description": "Settled claims explicitly considered by this assessment, including prospective references to an already examined vulnerability. Every settled IFS vulnerability-tagged claim must be listed in at least one assessment. Coverage does not supply a present affect, exclusion, protective-relationship or earned-Exile warrant, and does not propagate through dependencies.",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "affect_claim_ids": {
            "type": "array",
            "description": "Present affect or need warrants; every ID must also be explicitly examined. Examination membership alone is not an affect warrant.",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "exclusion_claim_ids": {
            "type": "array",
            "description": "Present internal-exclusion warrants; every ID must also be explicitly examined. A prospective Self relationship is not present internal exclusion.",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "protector_name_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "relationship_claim_ids": {
            "type": "array",
            "description": "Present protective-relationship warrants; every ID must also be explicitly examined. Prospective Self relationships belong in examined_claim_ids and do not supply these warrants.",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "alternative_account": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "candidate_id",
          "decision",
          "name_id",
          "examined_claim_ids",
          "affect_claim_ids",
          "exclusion_claim_ids",
          "protector_name_ids",
          "relationship_claim_ids",
          "alternative_account",
          "rationale"
        ]
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidate": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "reason_not_selected": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "candidate",
          "evidence_ids",
          "reason_not_selected"
        ]
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "observation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "disposition": {
            "enum": [
              "central",
              "supporting",
              "context",
              "not_material"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "observation_ids",
          "disposition",
          "reason"
        ]
      }
    },
    "layer_references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "report_type": {
            "enum": [
              "IFS",
              "PV",
              "ATT"
            ]
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "report_type",
          "claim_ids"
        ]
      }
    },
    "portraits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "entity_id": {
            "type": "string",
            "minLength": 1
          },
          "job_unit_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "expectation_unit_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "feared_outcome_unit_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "cost_unit_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "felt_experience_unit_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "longing_unit_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "release_condition_unit_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "self_relationship_unit_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "entity_id",
          "job_unit_ids",
          "expectation_unit_ids",
          "feared_outcome_unit_ids",
          "cost_unit_ids",
          "felt_experience_unit_ids",
          "longing_unit_ids",
          "release_condition_unit_ids",
          "self_relationship_unit_ids"
        ]
      },
      "description": "One unit-reference portrait per retained IFS part. Empty facets are permitted where not earned; do not fabricate a fear or longing to complete a form. Exiles require developed felt experience, not merely an affect label."
    }
  },
  "required": [
    "report_release",
    "release_id",
    "snapshot_id",
    "evidence_sha256",
    "report_type",
    "formulation_contract",
    "claims",
    "name_registry",
    "relationships",
    "units",
    "organizing_unit_ids",
    "development_order",
    "exile_assessments",
    "alternatives",
    "coverage",
    "layer_references",
    "portraits"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private source-bound formulation and narrator-safe meanings",
  "$defs": {
    "construct": {
      "enum": [
        "manager",
        "firefighter",
        "protective_function",
        "exile",
        "vulnerable_part",
        "vulnerable_theme",
        "internal_exclusion",
        "organizing_belief",
        "burden",
        "self_led_capacity",
        "unblending",
        "polarization",
        "part_relationship",
        "handoff",
        "loop",
        "state_pattern",
        "state_transition",
        "state_dependent_cognition",
        "recovery",
        "co_regulation",
        "attachment_anxiety",
        "attachment_avoidance",
        "secure_functioning",
        "working_expectation",
        "relational_pace",
        "repair",
        "context_contrast",
        "recurrence",
        "capacity",
        "practical_explanation",
        "description",
        "scope_limit"
      ]
    }
  }
}
