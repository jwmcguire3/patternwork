    {
      "phase": "mapping",
      "questionId": "M01",
      "optionText": "I kept finding things I ought to do."
    },
    {
      "phase": "mapping",
      "questionId": "M02",
      "optionText": "I asked someone else to look it over."
    },
    {
      "phase": "mapping",
      "questionId": "M03",
      "optionText": "Get a sign that it was good enough."
    },
    {
      "phase": "mapping",
      "questionId": "M04",
      "optionText": "I told whoever needed to know."
    },
    {
      "phase": "mapping",
      "questionId": "M05",
      "optionText": "I set stricter rules for myself."
    },
    {
      "phase": "mapping",
      "questionId": "M06",
      "optionText": "I worked harder to prevent another one."
    },
    {
      "phase": "mapping",
      "questionId": "M07",
      "optionText": "I passed the credit to someone else."
    },
    {
      "phase": "mapping",
      "questionId": "M08",
      "optionText": "I agreed to do it."
    },
    {
      "phase": "mapping",
      "questionId": "M09",
      "optionText": "They would be disappointed in me."
    },
    {
      "phase": "mapping",
      "questionId": "M10",
      "optionText": "I needed longer to take things in."
    },
    {
      "phase": "mapping",
      "questionId": "M11",
      "optionText": "I asked for help or company."
    },
    {
      "phase": "mapping",
      "questionId": "M12",
      "optionText": "I could carry on, but did not feel better."
    },
    {
      "phase": "mapping",
      "questionId": "M13",
      "optionText": "I spent time with someone I wanted to be with."
    },
    {
      "phase": "mapping",
      "questionId": "M14",
      "optionText": "I got a break, but it faded when I stopped."
    },
    {
      "phase": "mapping",
      "questionId": "M15",
      "optionText": "I asked for an update."
    },
    {
      "phase": "mapping",
      "questionId": "M16",
      "optionText": "Money, time, or another real opportunity was at stake."
    },
    {
      "phase": "mapping",
      "questionId": "M17",
      "optionText": "I sent another message."
    },
    {
      "phase": "mapping",
      "questionId": "M18",
      "optionText": "I mattered less to them than I wanted to."
    },
    {
      "phase": "mapping",
      "questionId": "M19",
      "optionText": "I kept looking for what the reply really meant."
    },
    {
      "phase": "mapping",
      "questionId": "M20",
      "optionText": "I asked for less than I needed."
    },
    {
      "phase": "mapping",
      "questionId": "M21",
      "optionText": "I did not want to add to what they were carrying."
    },
    {
      "phase": "mapping",
      "questionId": "M22",
      "optionText": "I kept managing how they helped."
    },
    {
      "phase": "mapping",
      "questionId": "M23",
      "optionText": "I named what I had done and apologized."
    },
    {
      "phase": "mapping",
      "questionId": "M25",
      "optionText": "I kept adding one more thing."
    },
    {
      "phase": "mapping",
      "questionId": "M26",
      "optionText": "I wanted help, and I wanted to manage alone."
    },
    {
      "phase": "mapping",
      "questionId": "M27",
      "optionText": "I acted on the first want in that pair."
    },
    {
      "phase": "mapping",
      "questionId": "M24",
      "optionText": "It helped, even though there was more to discuss."
    },
    {
